; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to [section] and is desired to be more readable.
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Thieflike (working title)"
run/main_scene="res://main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://autoload/game_state.gd"
TimelineManager="*res://autoload/timeline_manager.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/func_godot/plugin.cfg", "res://addons/gut/plugin.cfg")

