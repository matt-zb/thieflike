3d_physics/layer_2="PLAYER"
3d_physics/layer_3="NPC"
3d_physics/layer_4="INTERACTABLE"
3d_physics/layer_5="CARRIABLE"
3d_physics/layer_6="LIGHT_OCCLUDER"
